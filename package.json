{
  "name": "sellervate-pt",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "setup": "node scripts/setup-env.mjs",
    "db:start": "npx --yes supabase@2.117.0 start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:reset": "npx --yes supabase@2.117.0 db reset",
    "db:types": "npx --yes supabase@2.117.0 gen types typescript --local > lib/database.types.ts",
    "print-cookies": "tsx --conditions=react-server scripts/print-cookies.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "lucide-react": "^1.47.0",
    "next": "15.5.26",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "daisyui": "^5.7.43",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
