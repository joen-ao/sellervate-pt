# Copy to .env.local, then fill each value in. Every line is commented out on
# purpose: nothing here is a working default, and a half-real .env.local is
# harder to debug than an empty one.
#
# Run `supabase start` first — it prints the API URL and the keys below.

# Signs the httpOnly cookie that carries the stubbed user. The DAL trusts this
# signature and nothing else, so it must not be empty in any environment.
# Generate one with: openssl rand -hex 32
# SESSION_SECRET=

# Local Supabase REST endpoint, from the "API URL" line of `supabase start`.
# SUPABASE_URL=http://127.0.0.1:54321

# From the "service_role key" line of `supabase start`. Server-only: it bypasses
# RLS, so it must never reach a client component or NEXT_PUBLIC_ anything.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used by the application role — the one RLS applies
# to (spec 07). Local default from `supabase start` is:
# DATABASE_URL_APP=postgresql://postgres:postgres@127.0.0.1:54322/postgres
